                            </a></li>
                        <li><img class="digitel" src="/_layouts/15/TlvArchiveEng/images/footer/digitelnew.svg" alt=""></li>
                    </ul>
                </div>
                <div class="col-xs-12 col-md-4 footerLinks" ng-controller="footerCtrl as ftr" ng-init="ftr.init();" ng-cloak>
                    <nav aria-label="ניווט תחתון" class="footerLinksNav">
                        <ul class="row">
                             <li class="col-md-6 col-xs-6" ng-repeat="item in ftr.Items">
                                <a ng-href="{{ item.longURL.Url }}" title="" ng-target="{{ item.tlvLink.Target }}">{{ item.LinkTitle.Value }}</a>
                            </li>
                        </ul>
                    </nav>

                </div>
                <div class="footerExtra col-xs-12 col-md-4">
                    <ul class="footericons"><li><a href="https://www.instagram.com/telaviv.yafo/" target="_blank">
                        <img src="/_layouts/15/TlvArchiveEng/images/footer/instagram%20footer.svg" alt=" instagram"></a></li>
