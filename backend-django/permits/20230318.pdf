<link type="text/css" rel="stylesheet" href="/_layouts/15/TlvArchiveEng/styles/controls/mergeFolderForm.css" />

<script type="text/javascript" lang="he" src="/_layouts/15/TlvArchiveEng/scripts/controls/mergeFolderForm.js"></script>

<div class="merge-folder-form-container" ng-controller="MergeFolderCtrl as mfCtrl">
    <div class="close" aria-label="סגור" role="button" ng-click="mfCtrl.close()"></div>
    <div class="merge-folder-form-inner" ng-if="!mfCtrl.isFinish">
     <h2>מיזוג תיקי בניין</h2>
    <div class="msg">אתה עומד למזג את תיק בניין <strong>{{mfCtrl.currentFolder}}</strong> <br/> אנא בחר את תיק הבניין אליו אתה רוצה למזג את התיק הנוכחי.</div>
 <div class="bottom">
        <div class="target-folder-section">
             <input type="text" placeholder="מספר תיק למיזוג" ng-model="mfCtrl.targetFolder" autocomplete="off"  ng-keyup="mfCtrl.GetEngFolderId()" aria-describedby="m_txt_MergeFolderID_desc" ng-focus ="mfCtrl.targetFolder == undefind || mfCtrl.targetFolder =='' ? mfCtrl.folderHide = false : mfCtrl.folderHide = true"/>
                    <span class="sr-only" id="m_txt_MergeFolderID_desc">לבחירת ערך, התחל לכתוב את מספר התיק והשתמש בטאב. לאחר בחירת הערך, אשר את בחירתך באמצעות מקש  Enter</span>
                <div class="ul-list-group-item" ng-hide="mfCtrl.folderHide || mfCtrl.folderValue == undefined || mfCtrl.folderValue.length == 0" >
                <div class="closeDivBtn"  role="button" ng-keypress="mfCtrl.folderHide = true" ng-click="mfCtrl.folderHide = true" aria-label="סגור סוג מסמך" tabindex="0"></div>
                <ul ng-model="mfCtrl.targetFolder" >  
                    <li class="list-group-item" tabindex="0" ng-repeat="folder in mfCtrl.folderValue | orderBy:'Name'" ng-keypress="mfCtrl.GetSubTargetFolderData(folder.ID)" ng-click="mfCtrl.GetSubTargetFolderData(folder.ID)" value="{{folder.Name}}"  key="{{folder.ID}}">{{folder.Name}}</li>  
                </ul> 
                <div class="offset last-ul-list-group-item-Close-street" tabindex="0">חובה לסגור את איזור</div>
                </div> 
        </div>
  

    
            <a id="save" class="save" ng-click="mfCtrl.Save()">מזג תיקים</a>
        </div>
        
    <div class="initCurrentFolder" ng-click="mfCtrl.InitCurrentFolder()"></div>
</div>

    <div class="merge-folder-finish" ng-if="mfCtrl.isFinish">
        <div class="msg">{{mfCtrl.errMsg}}</div>
        <div class="close-btn" aria-label="אישור" ng-click="mfCtrl.close()">אישור</div>
    </div>
    </div>




<link type="text/css" rel="stylesheet" href="/_layouts/15/TlvArchiveEng/styles/controls/SweepingUpdate.css" />

<script type="text/javascript" lang="he" src="/_layouts/15/TlvArchiveEng/scripts/controls/SweepingUpdate.js"></script>


<div class="sweeping-update-container" ng-controller="SweepingUpdateCtrl as suCtrl" ng-init="suCtrl.initProps('https://handasaarchive.tel-aviv.gov.il/HandasaDocumentArchiveWS/')">
    <div class="close" aria-label="סגור" role="button" ng-click="suCtrl.close()"></div>
    <div class="sweeping-update-inner" ng-if="!suCtrl.isFinish">
        <h2>עדכון גורף למסמכים</h2>
        <div class="msg">אנא בחר שדה לעדכון עבור כל המסמכים שנבחרו</div>
         <div class="fields-name">
                    <input type="text" placeholder="שם שדה" ng-model="suCtrl.fieldName" autocomplete="off"  ng-keyup="suCtrl.GetFieldsName()" aria-describedby="m_txt_GetFieldName_desc" ng-focus ="suCtrl.fieldName == undefind || suCtrl.fieldName =='' ? suCtrl.fieldHide = false : suCtrl.fieldHide = true"/>
                    <span class="sr-only" id="m_txt_GetFieldName_desc">לבחירת ערך, התחל לכתוב את הרחוב והשתמש בטאב. לאחר בחירת הערך, אשר את בחירתך באמצעות מקש  Enter</span>
                <div class="ul-list-group-item" ng-hide="suCtrl.fieldHide || suCtrl.fieldValue == undefined || suCtrl.fieldValue.length == 0" >
                <div class="closeDivBtn"  role="button" ng-keypress="suCtrl.fieldHide = true" ng-click="suCtrl.fieldHide = true" aria-label="סגור שם שדה" tabindex="0"></div>
                <ul ng-model="suCtrl.fieldName" >  
                    <li class="list-group-item" tabindex="0" ng-repeat="field in suCtrl.fieldValue | orderBy:'DisplayName'" ng-keypress="suCtrl.GetSubFieldNameData(field.InternalName)" ng-click="suCtrl.GetSubFieldNameData(field.InternalName)" value="{{field.InternalName}}"  key="{{field.InternalName}}">{{field.DisplayName}}</li>  
                </ul> 
                <div class="offset last-ul-list-group-item-Close-street" tabindex="0">חובה לסגור את איזור</div>
                </div> 
                </div>

        <div class="msg">נא הקלד ערך לעדכון עבור כל המסמכים שנבחרו</div>
        <input type="text" ng-model="suCtrl.newVal" />

         <a id="save" class="save" ng-click="suCtrl.UpdateDocs()">עדכן</a>

        <div class="err-msg">{{suCtrl.errMsg}}</div>
    </div>

    <div class="sweeping-update-finish" ng-if="suCtrl.isFinish">
       <div class="msg">{{suCtrl.errMsg}}</div>
    </div>

     <div class="initSweepingUpdate" ng-click="suCtrl.InitSweepingUpdate()"></div>
</div>




<link type="text/css" rel="stylesheet" href="/_layouts/15/TlvArchiveEng/styles/controls/deleteFolderForm.css" />
<script type="text/javascript" lang="he" src="/_layouts/15/TlvArchiveEng/scripts/controls/deleteFolderForm.js"></script>

<div class="delete-folder-container" ng-controller="DeleteFolderCtrl as dfCtrl">
     <div class="close" aria-label="סגור" role="button" ng-click="dfCtrl.close()"></div>
    <div class="deleteAlert" ng-if="dfCtrl.isFinish==false" >
        
        <h2>מחיקת תיק בניין</h2>
        <p>האם אתה בטוח? אישור הפעולה ימחק את התיק <strong>{{dfCtrl.currentFolder}}</strong> ואת כל הקבצים שבתוכו</p>
    
        <div class="buttom">
            <a id="cancelBtn"  ng-click="dfCtrl.close()">ביטול</a>
            <a id="deleteBtn" ng-click="dfCtrl.deleteFolder()">אישור</a>
        </div>
    </div>
    <div class="delete-message-finish" ng-if="dfCtrl.isFinish">
      
        <h2>מחיקת תיק בניין</h2>
        <p>{{dfCtrl.finishMessage}}</p>
    </div>

    <div class="initCurrentDeleteFolder" ng-click="dfCtrl.InitCurrentFolder()"></div>
</div>


          
          



