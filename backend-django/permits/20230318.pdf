<section class="foorterContainerAll" role="contentinfo" id="footerOuter" tabindex="0" role="contentinfo">
    <div class="footerBottomALLDiv">
        <div class="footer-new row" role="contentinfo">
            <div class="footer-top row">
                <div class="app-section col-xs-12 col-md-4">
                    <h3>הורידו עכשיו את אפליקציית דיגיתל</h3>
                    <ul>
