				<div WebPartID="e11edf55-3946-4bbf-ae9b-65122095620c" HasPers="false" id="WebPartctl00_ctl51_g_e11edf55_3946_4bbf_ae9b_65122095620c" width="100%" class="ms-WPBody noindex " allowDelete="false" allowExport="false" style="" ><div id="ctl00_ctl51_g_e11edf55_3946_4bbf_ae9b_65122095620c">
					
    <div ng-controller="SearchBoxCtrl as sbCtrl" ng-init="sbCtrl.init('/Pages/SearchResultsAnonPageNew.aspx')">
        <div class="searchbox-container" >
    
    <div class="textbox-container">
        <h2 class="search-title">חיפוש תיק בניין</h2>
        <div class="params-search">
            <div class="right">
                <label for="searchType">בחר/י אופן חיפוש</label>
                <select id="searchType" ng-change="sbCtrl.ToogleTbByShearchType()" ng-model="sbCtrl.searchType">
                    <option value="address" selected="selected">כתובת</option>
                    <option value="block">גוש/חלקה</option>
                    <option value="permit">היתר</option>
                    <option value="request">בקשה</option>
                    <option value="numrequest">מספר בקשה מקוונת</option>
                </select>
            </div>
            <div class="left">

                <div  class="address" role="group" aria-label="לפי כתובת">
                
                    <p class="prop-title" aria-label="לפי כתובת"></p>
                    <div class="streetsOut">
                        
                
                <input placeholder="כתובת" id="address" ng-model="sbCtrl.streetMain" aria-label="כתובת" type="text" autocomplete="off" aria-describedby="m_txt_GetStreet_desc"  ng-keyup="sbCtrl.GetStreet()" ng-focus ="sbCtrl.streetMain == undefind || sbCtrl.streetMain =='' ? sbCtrl.streetHide = false : sbCtrl.streetHide = true" />
                <span class="sr-only" id="m_txt_GetStreet_desc">לבחירת ערך, התחל לכתוב את הרחוב והשתמש בטאב. לאחר בחירת הערך, אשר את בחירתך באמצעות מקש  Enter</span>
                <div class="ul-list-group-item" ng-hide="sbCtrl.streetHide || sbCtrl.streetValue == undefined || sbCtrl.streetValue.length == 0" >
                <div class="closeDivBtn"  role="button" ng-keypress="sbCtrl.streetHide = true" ng-click="sbCtrl.streetHide = true" aria-label="סגור רחובות" tabindex="0"></div>
                <ul ng-model="sbCtrl.streetMain" >  
                    <li class="list-group-item" tabindex="0" ng-repeat="street in sbCtrl.streetValue | orderBy:'captionField'" ng-keydown="nhl.closeSelected($event,'street')" ng-keypress="sbCtrl.getSubData('street',street.idField)" ng-click="sbCtrl.getSubData('street',street.idField)" value="{{street.captionField}}"  key="{{street.idField}}">{{street.captionField}}</li>  
                </ul> 
                <div class="offset last-ul-list-group-item-Close-street" tabindex="0">חובה לסגור את איזור</div>
                </div> 
            </div>
                    <div class="numbersOut">
              
                
                        <input placeholder="מס" id="numHouse" ng-model="sbCtrl.numberMain" aria-label="מספר" type="number" aria-describedby="m_txt_GetNumber_desc" autocomplete="off" ng-keyup="sbCtrl.GetNumber()" ng-focus ="sbCtrl.numberMain == undefind || sbCtrl.numberMain =='' ? sbCtrl.numberHide = false : sbCtrl.numberHide = true" />
                        <span class="sr-only" id="m_txt_GetNumber_desc">לבחירת ערך, התחל לכתוב את הרחוב והשתמש בטאב. לאחר בחירת הערך, אשר את בחירתך באמצעות מקש  Enter</span>
                        <div class="ul-list-group-item" ng-hide="sbCtrl.numberHide|| sbCtrl.numberValue == undefined || sbCtrl.numberValue.length == 0" >
                        <div class="closeDivBtn" role="button" ng-keypress="sbCtrl.numberHide = true" ng-click="sbCtrl.numberHide = true" aria-label="סגור מספרי בית" tabindex="0"></div>
                        <ul ng-model="sbCtrl.numberMain" >  
                            <li class="list-group-item" tabindex="0" ng-repeat="number in sbCtrl.numberValue | orderBy:'idField'" ng-keydown="nhl.closeSelected($event,'number')" ng-keypress="sbCtrl.getSubData('number',number.idField)" ng-click="sbCtrl.getSubData('number',number.idField)" value="{{number.captionField}}"  key="{{number.idField}}">{{number.captionField}}</li>  
                        </ul>
                        <div class="offset last-ul-list-group-item-Close-number" tabindex="0">חובה לסגור את איזור</div>
                        </div>    
                    </div>
                    <input type="text" id="entrance" placeholder="כניסה" ng-model="sbCtrl.enterance" aria-label="כניסה"/>  
                    <div class="get-location" tabindex="0" ng-click="sbCtrl.getSubDataByCoords()">קבל מיקום נוכחי</div>
                </div>
            
                <div class="block" role="group"  aria-label="לפי גוש/חלקה">
                    <p class="prop-title"></p>
                    <div class="inner-block"> 
                        <input type="number"  aria-label="גוש" id="block" placeholder="גוש" ng-model="sbCtrl.block" maxlength="4" ng-keypress="sbCtrl.validationText($event)"/>
                        <input type="number" aria-label="חלקה" id="plot" placeholder="חלקה" ng-model="sbCtrl.plot" maxlength="4" ng-keypress="sbCtrl.validationText($event)"/>
                     </div>
                </div>
                <div class="permit" >
                    <p class="prop-title" ></p>
                    <input type="number" aria-label="לפי היתר" id="permit" placeholder="היתר" ng-model="sbCtrl.permit"  maxlength="8" ng-keypress="sbCtrl.validationText($event)"/>
                </div>
                <div class="request" >
                    <p class="prop-title" ></p>
                    <input type="number" aria-label="לפי מס' בקשה" id="request" placeholder="בקשה" ng-model="sbCtrl.request"  maxlength="8" ng-keypress="sbCtrl.validationText($event)"/>
                </div>
                <div class="numrequest" >
                    <p class="prop-title" ></p>
                    <input type="number" aria-label="לפי מס' בקשה מקוונת" id="numrequest" placeholder="מספר בקשה מקוונת" ng-model="sbCtrl.numRequest" maxlength="8" ng-keypress="sbCtrl.validationText($event)"/>
                </div>
            </div>
            <div class="bottom">
                <a id="clear" role="button" tabindex="0" ng-click="sbCtrl.Clear()" ng-keypress="sbCtrl.Clear()">נקה</a>
                <a id="search" role="button" tabindex="0" ng-click="sbCtrl.Search()" ng-keypress="sbCtrl.Search()">חפש</a>
            
            </div>
        </div>
        
    </div>

    
    
