<link type="text/css" rel="stylesheet" href="/_layouts/15/TlvArchiveEng/styles/controls/onlineForm.css" />

<script type="text/javascript" lang="he" src="/_layouts/15/TlvArchiveEng/scripts/controls/onlineForm.js"></script>


<div class="online-form-container" id="onlineFormId" ng-controller="OnlineFormCtrl as form" ng-init="form.init()" name="onlineForm" role="alertdialog" aria-modal="true"
       aria-labelledby="online-form-title"  ng-cloak>
    <div class="online-form-inner">
        <div class="close" aria-label="סגור" role="button" ng-click="form.close()" ng-keypress="form.closeKeyWord($event)" ng-keydown="form.closeKeyWord($event)" tabindex="0"></div>
        <h2 id="online-form-title">פניה מקוונת לארכיון</h2>
        <div class="form-inputs">
            <div class="readonly-details">
                <div class="tik-num" ng-bind="">{{ form.fields.TikNumber}}</div>
                <div class="doc-url">{{ form.fields.FileName}}</div>
            </div>
            <div class="input"><label for="firstLevel">* דווח על</label>
                <select id="firstLevel" ng-model="form.fields.ReportType" ng-change="form.ChangeType()"  ng-required="true" aria-describedby="firstLevelErr">
                    <option ng-repeat="report in form.ReportTypeArr" ng-bind="report" value="{{report}}"></option>
                </select>
                  <span ng-show="form.validation.errReportType" class="err-msg" id="firstLevelErr" >דווח על הוא שדה חובה</span>
                </div>
            <div class="input">
                <label for="secondLevel">* סוג פניה</label>
                <select id="secondLevel" name="secondLevel" ng-model="form.fields.ErrorType" ng-required="true" required aria-describedby="secondLevelErr">
                     <option ng-repeat="type in form.refTypes track by $index" ng-bind="type" value="{{type}}"></option>
                </select>
                <span ng-show="form.validation.errErrorType" class="err-msg" id="secondLevelErr" >סוג פניה הוא שדה חובה</span>
            </div>
           
            <div class="input comments"><label for="note">הערה</label>
                <textarea id="note" ng-model="form.fields.ResidentNote" maxlength="3000" aria-multiline="true" ></textarea>
                <span class="info">נותרו {{3000 - form.fields.ResidentNote.length}} תווים</span>
            </div>
            <div class="input cbInput"><input id="returnToUser" type="checkbox" ng-keydown="form.cbkeywordpress($event)"   ng-model="form.fields.ReturnToUser"/><label for="returnToUser">מעוניין שנציג יחזור אליי</label></div>
            <div class="input">
                <span class="must-field" ng-show="form.fields.ReturnToUser">*</span>
                <label for="username">שם הפונה</label>
                <input id="username" name="GBmask_username" type="text" ng-model="form.fields.ResidentName" aria-required="{{form.fields.ReturnToUser}}" aria-describedby="usernameErr" ng-keydown="form.keywordpress($event)"/>
                <span ng-show="form.validation.errUsername" class="err-msg" id="usernameErr"  >שם פונה הוא שדה חובה</span>
            </div>
            <div class="input">
                <span class="must-field" ng-show="form.fields.ReturnToUser">*</span>
                <label for="phone">טלפון</label>
                <input id="phone" name="GBmask_phone" type="tel" ng-model="form.fields.ResidentPhoneNum" maxlength="10" autocomplete="on"  ng-keypress="form.validationText($event)" aria-required="{{form.fields.ReturnToUser}}"
                    aria-describedby="phoneErrReq phoneErrInvalid"/>
                <span ng-show="form.validation.errPhone" class="err-msg" id="phoneErrReq" >טלפון הוא שדה חובה</span>
                <span ng-show="form.validation.errPhoneValid" class="err-msg" id="phoneErrInvalid">מספר טלפון לא חוקי</span>
            </div>
            <div class="input">
                <label for="email">דוא"ל</label>
                <input id="email" type="email" name="GBmask_email" ng-model="form.fields.ResidentEmail" aria-required="{{form.fields.ReturnToUser}}" aria-describedby="emailErr" ng-keydown="form.keywordpress($event)"/>
                <span ng-show="form.validation.errEmail" class="err-msg" id="emailErr" >כתובת מייל לא חוקית</span>
            </div>      
             <div style="display:none" id='recaptcha' class="g-recaptcha"
                 data-sitekey="6Ld52b4oAAAAAAJ24Qrrxtal4vXGU6SQN3YZy-gD"
                 data-callback="onSubmit"
                 data-size="invisible"></div>
            <div class="send-outer"> <button id="send"  ng-click="form.Send($event)">שלח</button></div>
             <div class="offset lastDivClose onlineFormClose" tabindex="0">חובה לסגור את האיזור</div>
            
        </div>
         <div class="finish-info" id="finishInfo">
        <h3></h3>
        <div class="send-outer"> <button class="close-button"  ng-click="form.close()">סגור</button></div>
        <div class="offset lastDivClose onlineFormFinishClose" tabindex="0">חובה לסגור את האיזור</div>
    </div>
       
    </div>
   
</div>
