# Real Estate Agent Environment Configuration
# Copy this file to .env and modify as needed

# Django Backend
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgresql://broker_user:broker_pass@postgres:5432/realestate_broker

# Redis (for Celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (Resend)
RESEND_API_KEY=re_41X3KZvG_DfXVunG4An7XERMNzxMG1EbR
RESEND_FROM="RealEstate Agent <no-reply@yourdomain.com>"
RESEND_REPLY_TO=support@yourdomain.com
RESEND_SANDBOX=true
EMAIL_FALLBACK_TO_CONSOLE=true
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
EMAIL_DEFAULT_LANGUAGE=he

# Alternative SMTP configuration is no longer required. Emails are
# delivered via Resend when RESEND_API_KEY is provided. During
# development set EMAIL_FALLBACK_TO_CONSOLE=true to print emails.

# WhatsApp (for alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Test alert recipients (optional)
ALERT_DEFAULT_EMAIL=test@yourcompany.com
ALERT_DEFAULT_WHATSAPP_TO=+972501234567

# Frontend Environment Variables
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=local
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_MCP_YAD2_URL=http://localhost:8001
NEXT_PUBLIC_MCP_GOV_URL=http://localhost:8002
NEXT_PUBLIC_MCP_GIS_URL=http://localhost:8003
NEXT_PUBLIC_MCP_MAVAT_URL=http://localhost:8004
NEXT_PUBLIC_MCP_GOVMAP_URL=http://localhost:8005
NEXT_PUBLIC_MCP_HANDASA_URL=http://localhost:8006

# MCP Server Ports
MCP_YAD2_PORT=8001
MCP_GOV_PORT=8002
MCP_GIS_PORT=8003
MCP_MAVAT_PORT=8004
MCP_GOVMAP_PORT=8005
MCP_HANDASA_PORT=8006

# Collector tuning (optional)
# HANDASA_TIMEOUT=90
# HANDASA_RETRIES=0
# HANDASA_RETRY_DELAY=1.0

# Optional: External API Keys
# Gemini / Google AI Studio
GEMINI_API_KEY=your_gemini_api_key
# Alternatively you can set GOOGLE_API_KEY if you are copying the key directly
# from Google AI Studio.
# GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=your_gemini_api_key
# GOOGLE_MODEL=gemini-2.0-flash

# OpenAI
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.1-70b-versatile
# YAD2_API_KEY=your_yad2_api_key
# GOV_RAMI_API_KEY=your_gov_rami_api_key
# GIS_API_KEY=your_gis_api_key

PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBRRd4rR3IizmVVvN3KB-uswTfxDjjHdjQ
